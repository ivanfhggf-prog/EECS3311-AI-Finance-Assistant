a-&gt;b : == Automatic categorization == click Categorize (or runs after import)
b-&gt;c : categorizeAll()
c-&gt;d : processRequest(categorizeRequest)
d-&gt;f : decompose(request)
f.&gt;d : Plan
d-&gt;e : findByMonth(month)
e.&gt;d : uncategorized transactions
d-&gt;f : executePlan(plan, transactions)
f-&gt;g : executeTool(categorizer, args)
g-&gt;h : createTool(categorizer)
h.&gt;g : CategorizerTool
g-&gt;j : buildPrompt(context)
j.&gt;g : prompt
g-&gt;k : generate(prompt)
k-&gt;l : API request
l.&gt;k : response
k.&gt;g : response text
g-&gt;i : execute(input)
i.&gt;g : [recognized category] Category per transaction
i.&gt;g : [unrecognized or low confidence] Uncategorized, flagged for review
g.&gt;f : Result
f.&gt;d : Result
d-&gt;e : [loop: each transaction] save(transaction)
d.&gt;c : Result
c.&gt;b : categorized transactions
b.&gt;a : display color-coded transactions
a-&gt;b : == Manual correction == choose new category
b-&gt;c : correctCategory(txId, category)
c-&gt;d : handle(correctCategoryCommand)
d-&gt;n : execute()
n-&gt;e : [valid transaction and category] save(transaction)
n-&gt;m : [valid transaction and category] store(correction)
n.&gt;d : [valid transaction and category] success
n.&gt;d : [invalid] error
d.&gt;c : Result
c.&gt;b : Result
b.&gt;a : updated category or error message
